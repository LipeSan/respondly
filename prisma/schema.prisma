// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReviewStatus {
  pending
  responded
  failed
  skipped
}

enum RuleMode {
  auto
  manual
}

enum ResponseMethod {
  template
  ai
  manual
}

enum AppRole {
  user
  support
  admin
}

model User {
  id         String     @id @default(cuid())
  name       String?
  email      String     @unique
  password   String?
  role       AppRole    @default(user)
  createdAt  DateTime   @default(now())
  businesses Business[]
  passwordResetTokens PasswordResetToken[]
  trialInvites TrialInvite[] @relation("TrialInviteReservedBy")
  adminAuditLogs AdminAuditLog[] @relation("AdminAuditActor")
  targetedAdminAuditLogs AdminAuditLog[] @relation("AdminAuditTargetUser")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Business {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  name     String
  phone    String?
  email    String?
  timezone String  @default("Australia/Sydney")

  googleAccountName  String?
  googleLocationName String?
  googleLocationId   String? // ex: locations/123... ou accounts/xxx/locations/yyy

  initialSyncCompleted Boolean       @default(false)
  connectedAt          DateTime?
  subscription         Subscription?

  autoResponderEnabled Boolean           @default(false)
  aiSettings           Json?
  google               GoogleConnection?
  templates            ReviewTemplate[]
  rules                ReviewRule[]
  reviews              Review[]
  jobRuns              JobRun[]
  paymentHistory       PaymentHistory[]
  trialInvites         TrialInvite[] @relation("TrialInviteReservedByBusiness")
  usedTrialInvites     TrialInvite[] @relation("TrialInviteUsedByBusiness")
  trialInviteRedemptions TrialInviteRedemption[]
  adminAuditLogs       AdminAuditLog[] @relation("AdminAuditTargetBusiness")
  createdAt            DateTime          @default(now())
}

model GoogleConnection {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id])

  accessToken  String
  refreshToken String
  expiresAt    DateTime
  locationId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReviewTemplate {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  name      String
  body      String
  createdAt DateTime     @default(now())
  rules     ReviewRule[]
}

model ReviewRule {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  priority     Int            @default(100)
  minStars     Int?
  maxStars     Int?
  mode         RuleMode       @default(auto)
  responseType ResponseMethod @default(template)

  templateId String?
  template   ReviewTemplate? @relation(fields: [templateId], references: [id])

  aiSettings Json?
  createdAt  DateTime @default(now())

  @@index([businessId, priority])
}

model Review {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  source          String    @default("mock") // "google" | "mock"
  externalId      String? // google review name/id (unique per business)
  rating          Int
  authorName      String?
  comment         String?
  createdAtGoogle DateTime?

  status    ReviewStatus @default(pending)
  lastError String?

  response  ReviewResponse?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt // ✅ ADD

  @@unique([businessId, source, externalId]) // ✅ ADD (dedupe)
  @@index([businessId, status]) // ✅ ADD (fila)
  @@index([businessId, createdAtGoogle]) // ✅ ADD (ordenar pelo google)
}

model ReviewResponse {
  id       String @id @default(cuid())
  reviewId String @unique
  review   Review @relation(fields: [reviewId], references: [id])

  ruleId    String?
  method    ResponseMethod
  generated String?
  finalText String
  sentAt    DateTime?

  createdAt DateTime @default(now())
}

enum JobType {
  sync_reviews
  auto_responder
}

enum JobStatus {
  running
  success
  failed
}

model JobRun {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  type   JobType
  status JobStatus @default(running)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  processed Int @default(0)
  responded Int @default(0)
  skipped   Int @default(0)

  error String?

  createdAt DateTime @default(now())

  @@index([businessId, type])
  @@index([businessId, createdAt])
}

model Subscription {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id])

  plan                 String // starter | pro
  status               String // active | canceled | past_due
  cancelAtPeriodEnd    Boolean  @default(false)
  cancelAt             DateTime?
  currentPeriodEnd     DateTime?
  trialUsedAt          DateTime?
  trialEndsAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrialInvite {
  id                 String   @id @default(cuid())
  code               String   @unique
  days               Int
  email              String?

  reservedAt         DateTime?
  reservedByUserId   String?
  reservedByBusinessId String?
  reservedByUser     User?     @relation("TrialInviteReservedBy", fields: [reservedByUserId], references: [id])
  reservedByBusiness Business? @relation("TrialInviteReservedByBusiness", fields: [reservedByBusinessId], references: [id])

  usedAt             DateTime?
  usedByBusinessId   String?
  usedByBusiness     Business? @relation("TrialInviteUsedByBusiness", fields: [usedByBusinessId], references: [id])
  redemptions        TrialInviteRedemption[]

  createdAt          DateTime @default(now())

  @@index([email])
  @@index([usedAt])
  @@index([reservedAt])
}

model TrialInviteRedemption {
  id         String      @id @default(cuid())
  inviteId   String
  businessId String
  invite     TrialInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([inviteId, businessId])
  @@index([inviteId, createdAt])
  @@index([businessId, createdAt])
}

model AdminAuditLog {
  id               String   @id @default(cuid())
  actorUserId      String
  actorUser        User     @relation("AdminAuditActor", fields: [actorUserId], references: [id])
  action           String

  targetUserId     String?
  targetUser       User?    @relation("AdminAuditTargetUser", fields: [targetUserId], references: [id])
  targetBusinessId String?
  targetBusiness   Business? @relation("AdminAuditTargetBusiness", fields: [targetBusinessId], references: [id])

  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([targetBusinessId, createdAt])
  @@index([action, createdAt])
}

model PaymentHistory {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  stripeEventId          String @unique
  stripeEventType        String
  stripeInvoiceId        String?
  stripePaymentIntentId  String?
  stripeCustomerId       String?
  stripeSubscriptionId   String?

  amount  Int?
  currency String?
  status  String
  paidAt  DateTime?

  hostedInvoiceUrl String?
  invoicePdf       String?
  rawEvent         Json?

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([stripeInvoiceId])
}

model ContactMessage {
  id          String   @id @default(cuid())
  email       String
  description String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
